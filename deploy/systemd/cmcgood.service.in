[Unit]
Description=cmcgood - 开发部代码仓管理 (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
Environment=CMCGOOD_CONFIG=@CONF_FILE@
ExecStart=@APP_DIR@/venv/bin/gunicorn --workers 2 --threads 4 --bind @BIND@ --access-logfile - wsgi:app
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
