# 开发部代码仓管理 —— 配置文件示例
# 服务器上位于 /etc/cmcgood/cmcgood.env（install.sh 首次安装时自动生成），本地开发放在 instance/cmcgood.env
# 修改后执行 systemctl restart cmcgood 生效

# ---------- 基础 ----------
# 会话加密密钥，install.sh 会自动生成；换服务器时要随数据库一起迁移
SECRET_KEY=
# 数据目录（SQLite 数据库、备份都在这里）
DATA_DIR=/var/lib/cmcgood
SITE_NAME=开发部代码仓管理
# 站点对外访问地址，用于通知里的链接，例如 https://dev.example.com/cmc
SITE_URL=
# 是否允许自助注册（新注册用户为「开发人员」角色；系统中第一个用户自动成为管理员）
ALLOW_REGISTER=1
# 站点走 HTTPS 时设为 1
SESSION_COOKIE_SECURE=0
# 页面显示用的时区偏移（小时）
TZ_OFFSET_HOURS=8

# ---------- GitHub ----------
# token 建议用 fine-grained PAT：组织仓库 Metadata/Contents 只读；需要自动建仓时再加 Administration 写权限
GITHUB_TOKEN=
# 扫描范围，逗号分隔；个人账号加 user: 前缀，例如 my-org,another-org,user:alice
GITHUB_NAMESPACES=
# GitHub Enterprise 才需要改
# GITHUB_API=https://api.github.com
# GITHUB_WEB=https://github.com

# ---------- GitCode ----------
# 在 gitcode.com「个人设置 → 访问令牌」中创建
GITCODE_TOKEN=
GITCODE_NAMESPACES=
# GITCODE_API=https://api.gitcode.com/api/v5
# GITCODE_WEB=https://gitcode.com

# 审批通过后是否用上面的 token 自动在平台上创建仓库（0=只登记，由管理员手动创建）
AUTO_CREATE_REPO=0

# ---------- 活跃度 ----------
# 默认分支超过多少天没有新提交判定为不活跃
INACTIVE_DAYS=180
# 列表里「近 N 天提交数」的统计窗口
ACTIVITY_WINDOW_DAYS=90
# 对同一个不活跃仓库，两次提醒的最小间隔天数
REMIND_INTERVAL_DAYS=14
# 负责人点「暂不归档」后多少天内不再提醒
SNOOZE_DAYS=90

# ---------- 邮件通知（可选） ----------
SMTP_HOST=
SMTP_PORT=465
# ssl / starttls / none
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
# 例如：代码仓管理 <noreply@example.com>
MAIL_FROM=

# ---------- 群机器人通知（可选） ----------
# wecom（企业微信）/ feishu（飞书）/ dingtalk（钉钉）/ slack
WEBHOOK_TYPE=wecom
WEBHOOK_URL=
# 钉钉机器人如果开了「自定义关键词」安全设置，关键词填：代码仓管理

# ---------- 代理（可选，服务器访问 GitHub 需要代理时） ----------
# HTTPS_PROXY=http://127.0.0.1:7890
